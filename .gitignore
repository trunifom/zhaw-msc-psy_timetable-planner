# Python Caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Environments
.env
.venv
env/
venv/
ENV/

# Lokale Daten (Strikter Ausschluss von Rohdaten)
data/*
!data/.gitkeep

# data/real/ enthaelt die echte, persoenliche Excelliste des Nutzers.
# Nie einchecken - eigenes .gitignore dort regelt den Inhalt im Detail.
!data/real/

# OS generierte Dateien
.DS_Store
Thumbs.db